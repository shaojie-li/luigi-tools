{
  "name": "business-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "lint": "eslint --config eslint.config.ts . --max-warnings=0",
    "lint:fix": "eslint --config eslint.config.ts . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "lint-staged && npm run lint && npm run format:check && npm run typecheck",
    "prepare": "tsx tooling/setup-hooks.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "tooling:setup": "tsx tooling/setup-hooks.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-table": "8.21.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "jiti": "2.7.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "prettier": "^3.9.9",
    "eslint-plugin-react-x": "5.23.5"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
