{
  "name": "@luigix/tools",
  "version": "2.0.0",
  "description": "初始化业务项目，分发 Skills、UI 组件与项目管理预设",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts scripts/*.test.ts",
    "smoke": "pnpm build && tsx scripts/smoke.ts",
    "release": "semantic-release",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "lint": "eslint --config eslint.config.ts . --max-warnings=0",
    "lint:fix": "eslint --config eslint.config.ts . --fix --max-warnings=0",
    "precommit": "lint-staged && npm run lint && npm run format:check && npm run typecheck",
    "prepare": "tsx tooling/setup-hooks.ts",
    "prepack": "node dist/verify-package.js"
  },
  "type": "module",
  "bin": {
    "lt": "dist/index.js"
  },
  "files": [
    "dist",
    "sources.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "zod": "4.6.5",
    "yaml": "^2.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaojie-li/luigi-tools.git"
  },
  "homepage": "https://github.com/shaojie-li/luigi-tools#readme",
  "bugs": {
    "url": "https://github.com/shaojie-li/luigi-tools/issues"
  },
  "keywords": [
    "cli",
    "react",
    "typescript",
    "agent",
    "skills",
    "scaffolding"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "jiti": "2.7.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "eslint-plugin-react-x": "5.23.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9",
    "@semantic-release/git": "11.0.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
